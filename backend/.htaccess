# Blok akses HTTP langsung ke folder backend/.
# File PHP di sini (Controllers, Core, config.php) hanya di-load via
# require() dari /index.php di root. Akses langsung via URL ditolak.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
